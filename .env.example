# --- Django ---
SECRET_KEY=replace-with-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.220
CSRF_TRUSTED_ORIGINS=http://192.168.1.220:8686
TIME_ZONE=Australia/Adelaide

# --- Database ---
# postgres (default, for containers) or sqlite (quick local dev)
DB_ENGINE=postgres
POSTGRES_DB=roost
POSTGRES_USER=roost
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- App ---
# host port mapped to the container's 8000
APP_PORT=8686

# --- DeepSeek (optional: read utility bills from PDFs) ---
DEEPSEEK_KEY=
DEEPSEEK_MODEL=deepseek-flash
