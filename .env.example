# --- Django ---
SECRET_KEY=replace-with-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.220
CSRF_TRUSTED_ORIGINS=http://192.168.1.220:8686
TIME_ZONE=Australia/Adelaide

# --- Database ---
# postgres (default, for containers) or sqlite (quick local dev)
DB_ENGINE=postgres
POSTGRES_DB=roost
POSTGRES_USER=roost
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- App ---
# host port mapped to the container's 8000
APP_PORT=8686

# --- DeepSeek (optional: read utility bills from PDFs, and receipts) ---
DEEPSEEK_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Vision model for reading *photographed* receipts (the highlighted lines).
# Any OpenAI-compatible chat endpoint that accepts image content works, e.g. a
# DeepSeek vision model, or a local Ollama:
#   DEEPSEEK_VISION_BASE_URL=http://192.168.1.x:11434/v1
#   DEEPSEEK_VISION_MODEL=gemma4:latest   (with DEEPSEEK_KEY=ollama)
# Leave blank to fall back to the text model/base URL (photographed receipts
# then report that no vision model is available rather than guessing).
DEEPSEEK_VISION_MODEL=
DEEPSEEK_VISION_BASE_URL=
