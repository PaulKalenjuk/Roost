#!/usr/bin/env bash
#
# Roost backup configuration.
#
# Copy to ~/roost/config/backup.env (chmod 600) and edit as needed. The backup
# and restore scripts read it from $ROOST_BACKUP_CONF, defaulting to
# ~/roost/config/backup.env.
#
# The Google Drive credentials themselves live in the rclone config
# (~/.config/rclone/rclone.conf), NOT here — this file only names the remote.

# rclone remote (an encrypted `crypt` remote over Google Drive by default).
# Change the account by pointing this at a different remote, or re-run
# `rclone authorize drive` and update rclone.conf.
ROOST_BACKUP_REMOTE=gdrive-crypt:
# Optional subfolder inside that remote (leave empty for the remote root).
ROOST_BACKUP_SUBDIR=

# How many recent restore points to keep, both on the host and on the remote.
ROOST_BACKUP_KEEP=3

# Local staging directory for the restore points.
ROOST_BACKUP_DIR=/home/paulkalenjuk/roost/backups

# Postgres container + credentials (used via `podman exec`).
ROOST_DB_CONTAINER=roost-db
ROOST_DB_USER=roost
ROOST_DB_NAME=roost

# Host path of the media volume (uploads: receipts, bills, asset photos, PDFs).
ROOST_MEDIA_DIR=/home/paulkalenjuk/.local/share/containers/storage/volumes/roost-media/_data
