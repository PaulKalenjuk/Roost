# /home/paulkalenjuk/roost/config/roost.env   (chmod 600)
# Used by both the roost-db and roost-app containers.

# --- Django ---
SECRET_KEY=replace-with-a-long-random-string
DEBUG=false
ALLOWED_HOSTS=192.168.1.220,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://192.168.1.220:8686
TIME_ZONE=Australia/Adelaide

# --- Database (host = the container name on the roost network) ---
DB_ENGINE=postgres
POSTGRES_DB=roost
POSTGRES_USER=roost
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=roost-db
POSTGRES_PORT=5432

# --- First-boot admin (optional; remove after first successful boot) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=replace-with-a-strong-password
DJANGO_SUPERUSER_EMAIL=
